{
	"name": "superstarter",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#scripts/*": "./scripts/*"
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"env:pull": "pnpm --filter @superstarter/nextjs-app run env:pull",
		"dev": "pnpm --filter @superstarter/nextjs-app dev",
		"build": "turbo run build",
		"start": "pnpm --filter @superstarter/nextjs-app start",
		"typecheck": "node scripts/dev/check.ts typecheck typecheck:tooling",
		"typecheck:tooling": "tsc --noEmit -p tsconfig.json",
		"lint": "node scripts/dev/check.ts lint lint:repository lint:fixtures lint:oxlint",
		"lint:repository": "node scripts/dev/lint.ts --repository",
		"lint:fixtures": "node scripts/dev/lint.ts --fixtures",
		"lint:oxlint": "oxlint",
		"style": "node scripts/dev/check.ts style:check",
		"style:check": "node scripts/dev/style.ts",
		"format": "node scripts/dev/check.ts format:check",
		"format:check": "oxfmt --check scripts packages rules package.json turbo.json tsconfig.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json .fallowrc.json AGENTS.md README.md && node scripts/dev/fmt.ts",
		"format:write": "oxfmt scripts packages rules package.json turbo.json tsconfig.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json .fallowrc.json AGENTS.md README.md && node scripts/dev/fmt.ts --write",
		"dead-code": "node scripts/dev/check.ts dead-code:check",
		"dead-code:check": "fallow dead-code",
		"check": "node scripts/dev/check.ts typecheck typecheck:tooling lint lint:repository lint:fixtures lint:oxlint style:check format:check dead-code:check",
		"db:generate": "pnpm --filter @superstarter/database run generate",
		"db:migrate": "pnpm --filter @superstarter/data-infrastructure run db:migrate",
		"db:studio": "pnpm --filter @superstarter/data-infrastructure run db:studio",
		"db:local": "pnpm --filter @superstarter/data-infrastructure run db:local",
		"db:local:stop": "pnpm --filter @superstarter/data-infrastructure run db:local:stop",
		"test": "node scripts/dev/check.ts test"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.5",
		"@effect/tsgo": "0.56.0",
		"@tailwindcss/node": "4.3.3",
		"@types/node": "24.19.2",
		"effect": "4.0.5",
		"fallow": "3.34.1",
		"lefthook": "2.2.2",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"turbo": "2.11.7",
		"typescript": "7.0.2"
	}
}
