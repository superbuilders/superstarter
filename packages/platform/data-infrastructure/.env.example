# Copy to .env.local in this directory and fill in both values. The package scripts load it with
# `node --env-file-if-exists=.env.local`; nothing else reads it. The database scripts (db:*) first load
# the app's .env.local, which `pnpm env:pull` writes from Vercel (DATABASE_HOST,
# DATABASE_ADMIN_SECRET_ARN, AWS_ROLE_ARN and VERCEL_OIDC_TOKEN); a value set here overrides it.

# The Vercel team slug, as in the dashboard URL. It names the OIDC issuer AWS trusts.
VERCEL_TEAM_SLUG=

# The Vercel project whose deployments assume the runtime role.
VERCEL_PROJECT_NAME=

# AWS credentials are not configured here: scripts/with-aws.ts reads the DevFactory dump at
# ~/Downloads/credentials.json, or the file DEVFACTORY_CREDS_PATH names.
