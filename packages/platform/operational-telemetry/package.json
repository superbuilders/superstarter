{
	"name": "@superstarter/operational-telemetry",
	"version": "0.0.0",
	"private": true,
	"description": "Host-neutral operational telemetry: the span registry, the Effect tracer and logger bridged to OpenTelemetry, failure classification, and the exporters that ship spans, logs and metrics to PostHog or to local JSONL files.",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./correlation": "./src/correlation.ts",
		"./destination": "./src/destination.ts",
		"./effect": "./src/effect.ts",
		"./export-health": "./src/export-health.ts",
		"./failure": "./src/failure.ts",
		"./file-export": "./src/file-export.ts",
		"./metrics": "./src/metrics.ts",
		"./remote": "./src/remote.ts",
		"./resource": "./src/resource.ts",
		"./schema": "./src/schema.ts",
		"./sdk-limits": "./src/sdk-limits.ts",
		"./span-export": "./src/span-export.ts",
		"./spans": "./src/spans.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "node ../../../scripts/dev/lint.ts"
	},
	"dependencies": {
		"@superstarter/todo-protocol": "workspace:*",
		"@effect/platform-node": "4.0.5",
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/api-logs": "0.223.0",
		"@opentelemetry/core": "2.12.0",
		"@opentelemetry/otlp-transformer": "0.223.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-logs": "0.223.0",
		"@opentelemetry/sdk-metrics": "2.12.0",
		"@opentelemetry/sdk-trace": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"effect": "4.0.5",
		"uuid": "14.0.3"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "7.0.2"
	}
}
