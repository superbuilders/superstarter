# Vercel's environment is the only secret store. Set these in the Vercel project, then run
# `pnpm env:pull` to write this package's .env.local, which also brings VERCEL_OIDC_TOKEN for local AWS
# access. src/env.ts declares and validates every variable the app reads.

# The IAM role the runtime assumes through Vercel OIDC: arn:aws:iam::<account>:role/<name>
AWS_ROLE_ARN=

# The RDS endpoint, no scheme and no port: <id>.<suffix>.us-east-1.rds.amazonaws.com
DATABASE_HOST=

# The RDS master credentials secret. The app never reads it: the database scripts in
# @superstarter/data-infrastructure (pnpm db:*) load this package's .env.local and read it there.
DATABASE_ADMIN_SECRET_ARN=

# PostHog's project token (phc_…): OTLP export, server exceptions and the browser client. Set it in
# Vercel for its deployments (production and preview) only. It is read only when VERCEL_DEPLOYMENT_ID is
# set; locally, telemetry is written to this package's out/telemetry/*.jsonl and this stays empty.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Local only, and optional: the database on the PostgreSQL 18 `pnpm db:local` runs at localhost:5434,
# where the app signs in as `app` without a password. It defaults to `superstarter` (src/env.ts);
# `pnpm test` sets `superstarter_test`.
LOCAL_POSTGRES_DATABASE=
